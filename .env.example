# Copie este arquivo para ".env" e preencha com sua chave real
# Gemini é gratuito: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
# Gere um valor longo e aleatório para proteger a API, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=gere_um_token_forte_aqui
# Limite de chamadas que podem consumir a API do Gemini por API key
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60