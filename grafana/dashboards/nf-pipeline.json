{
  "uid": "nf-pipeline",
  "title": "NF Pipeline - Operacao",
  "tags": ["notas-fiscais", "operacao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-365d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Notas processadas",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Notas aprovadas",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais WHERE status = 'aprovada';",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Notas rejeitadas",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais WHERE status = 'rejeitada';",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processamento por dia",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', criado_em) AS time, status, COUNT(*) AS total FROM notas_fiscais GROUP BY 1, 2 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Motivos de rejeicao",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COALESCE(motivo_rejeicao, 'Sem motivo') AS motivo, COUNT(*) AS total FROM notas_fiscais WHERE status = 'rejeitada' GROUP BY 1 ORDER BY total DESC;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Gasto vs orçamento por etapa",
      "datasource": { "type": "postgres", "uid": "nf-postgres" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT etapa.nome AS etapa, etapa.orcamento_planejado AS \"Orçamento planejado\", COALESCE(SUM(nota.valor_total), 0) AS \"Gasto aprovado\" FROM etapas AS etapa LEFT JOIN notas_fiscais AS nota ON nota.etapa_id = etapa.id AND nota.obra_id = etapa.obra_id AND nota.status = 'aprovada' WHERE etapa.obra_id = 1 GROUP BY etapa.id, etapa.nome, etapa.orcamento_planejado ORDER BY etapa.id;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "etapa",
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}
