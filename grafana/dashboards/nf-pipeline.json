{
  "uid": "nf-pipeline",
  "title": "NF Pipeline - Operacao",
  "tags": ["notas-fiscais", "operacao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Notas processadas",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Notas aprovadas",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais WHERE status = 'aprovada';",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Notas rejeitadas",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM notas_fiscais WHERE status = 'rejeitada';",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processamento por dia",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', criado_em) AS time, status, COUNT(*) AS total FROM notas_fiscais WHERE criado_em BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1, 2 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Motivos de rejeicao",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COALESCE(motivo_rejeicao, 'Sem motivo') AS motivo, COUNT(*) AS total FROM notas_fiscais WHERE status = 'rejeitada' AND criado_em BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1 ORDER BY total DESC;",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "legend": { "displayMode": "hidden" } }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}
